# DaddyDefender Backend Configuration
# Copy this file to .env and fill in your values.
# All API keys are OPTIONAL. The app works without them using local analysis only.

# ── Google Gemini ─────────────────────────────────────
# Get your key at https://aistudio.google.com/apikey
# Used for AI-assisted threat explanations. Optional.
GEMINI_API_KEY=

# ── VirusTotal ────────────────────────────────────────
# Get your key at https://www.virustotal.com/gui/my-apikey
# Free tier: 4 requests/minute, 500 requests/day
# Used for URL reputation lookups. Optional.
VIRUSTOTAL_API_KEY=

# ── URLhaus ───────────────────────────────────────────
# No API key required. Enable/disable with this flag.
# Checks URLs against abuse.ch known malicious URL database.
URLHAUS_ENABLED=true

# ── Server ────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# ── Database ──────────────────────────────────────────
# SQLite database file path (relative to backend directory)
DATABASE_PATH=daddydefender.db

# ── Rate Limiting ─────────────────────────────────────
# Max analysis requests per minute per IP
RATE_LIMIT=30/minute
